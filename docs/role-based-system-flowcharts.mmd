subgraph ADMIN["Admin / Owner Detailed Flow"]
direction TB

A0([Start])
A1["Login as admin
POST /login"]
A2{"Auth + role check passed?"}
A3["Admin dashboard shell"]
A4{"Admin clicks feature"}

%% Dashboard
A5["Dashboard feature:
GET /dashboard/admin/stats
GET /appointments
GET /sales/stats (if admin)"]
A6{"Dashboard card click"}
A7["Navigate to filtered page:
- appointments by status/range
- sales reports
- service management
- customers"]

%% Customers
A8["Customers feature:
GET /appointments
Group by email/phone and show history"]

%% Services
A9["Services feature:
GET /services"]
A10{"Service action"}
A11["Create/Update/Delete service:
POST/PATCH/DELETE /services"]
A12["Variants CRUD:
GET/POST/PATCH/DELETE service variants"]

%% Staff (Stylists + Managers)
A13["Staff feature:
GET /stylists + GET /managers"]
A14{"Staff action type"}
A15["Stylist CRUD + activate/deactivate:
POST/PATCH/DELETE /stylists"]
A16["Time-off add/remove:
POST/DELETE /stylists/{id}/time-offs"]
A17["Manager CRUD + activate/deactivate:
POST/PATCH/DELETE /managers"]

%% Approvals
A18["Approvals feature:
GET /admin/staff/pending"]
A19{"Approval action"}
A20["Approve request:
PATCH /admin/staff/{id}/approve
(if role=stylist create/update stylist record)"]
A21["Reject request:
PATCH /admin/staff/{id}/reject
with reason"]

%% Appointments
A22["Appointments feature:
GET /appointments + GET /stylists + GET /services"]
A23{"Appointment action"}
A24["Confirm:
POST /appointments/{id}/confirm"]
A25["Complete:
POST /appointments/{id}/complete
-> mark paid
-> create sales rows
-> send magic link if needed"]
A26["Cancel:
POST /appointments/{id}/cancel"]
A27["Reschedule:
POST /appointments/{id}/reschedule"]
A28["Update payment status:
PATCH /appointments/{id}"]
A29["Delete:
DELETE /appointments/{id}"]
A30{"Reschedule validation:
holiday/time window/conflict?"}

%% Reviews
A31["Reviews feature:
GET /ratings + stylists + appointment detail"]
A32{"Review action"}
A33["Delete review:
DELETE /ratings/{id}"]

%% Holidays
A34["Holidays feature:
GET /holidays"]
A35{"Holiday action"}
A36["Create/Update/Delete holiday
POST/PATCH/DELETE /holidays"]
A37["Effect:
closed dates block booking/reschedule"]

%% Payments
A38["Payments feature:
GET /payment-accounts/all"]
A39{"Payment account action"}
A40["Create/Update/Delete account:
POST/PATCH/DELETE /payment-accounts"]
A41["Effect:
payment options used in booking"]

%% Inventory
A42["Inventory feature:
GET /inventory + GET /inventory/stats"]
A43{"Inventory action"}
A44["Create/Update/Delete inventory:
POST/PATCH/DELETE /inventory"]

%% Reports / Sales
A45["Reports feature:
GET /sales?filters
GET /sales/stats?date range"]
A46["View KPIs:
totals, by type, by payment,
top-selling items, transactions list"]

%% Extra admin api capability
A47["Location management (API capability):
GET /locations/all
POST/PATCH/DELETE /locations"]

%% Common exit
A48["Profile photo (optional):
POST/DELETE /me/profile-photo"]
A49["Logout
POST /logout"]
A50([End])

