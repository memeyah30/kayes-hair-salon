subgraph CUSTOMER["Client / Customer Detailed Flow"]
direction TB

C0([Start])
C1["Open Home page"]
C2["Load public modules:
- Services list
- Stylists list
- Availability by stylist
- Holiday check
- Payment accounts
- Locations"]
C3{"Customer action"}
C4["Click Book Appointment"]
C5["Fill booking form:
- services + variants
- stylist
- date/time
- customer details
- payment method/proof"]
C6{"Booking validation passed?
- date is today/future
- not closed holiday
- business hours
- slot conflict check
- payment/deposit rules"}
C7["Create appointment
POST /appointments"]
C8["Open receipt
GET /appointments/{id} /receipt"]
C9["Appointment completed later:
system sends magic-link email"]
C10{"Manage booking entry"}
C11["Magic link:
GET /a/{token}"]
C12{"Magic token valid?"}
C13["Create session and redirect /customer"]
C14["OTP start:
POST /manage-booking/send-otp"]
C15{"OTP send allowed?
- SMTP configured
- email has appointments"}
C16["Verify OTP:
POST /manage-booking/verify-otp"]
C17{"OTP valid/not expired/attempts left?"}
C18["Issue manage-booking token"]
C19["Customer dashboard loaded:
- OTP mode: GET /manage-booking/appointments
- legacy mode: GET /dashboard/customer/stats"]
C20{"Dashboard click"}
C21["Book New -> back to booking form"]
C22["Open Manage Booking list"]
C23["Reschedule click"]
C24["Cancel click"]
C25["Rate click"]
C26{"Reschedule/Cancel allowed?
- owned appointment
- status in booked/pending/confirmed
- >= 3 hours before
- no overlap conflict"}
C27{"Rating allowed?
- owned appointment
- completed
- not yet rated"}
C28["Apply update:
reschedule/cancel endpoint"]
C29["Save ratings:
appointment_ratings + customer_ratings"]
C30["Refresh dashboard data"]
C31["Optional public rating endpoint:
POST /ratings"]
C32([End])

C0 --> C1 --> C2 --> C3
C3 -- "Book Appointment" --> C4 --> C5 --> C6
C6 -- "No" --> C5
C6 -- "Yes" --> C7 --> C8 --> C9 --> C10

C3 -- "Manage Booking" --> C10
C10 -- "Magic Link" --> C11 --> C12
C12 -- "No" --> C14
C12 -- "Yes" --> C13 --> C19

C10 -- "OTP Flow" --> C14 --> C15
C15 -- "No" --> C32
C15 -- "Yes" --> C16 --> C17
C17 -- "No" --> C16
C17 -- "Yes" --> C18 --> C19

C19 --> C20
C20 -- "Book New" --> C21 --> C4
C20 -- "View Appointments" --> C22 --> C19
C20 -- "Reschedule" --> C23 --> C26
C20 -- "Cancel" --> C24 --> C26
C26 -- "No" --> C19
C26 -- "Yes" --> C28 --> C30 --> C19

C20 -- "Rate Completed" --> C25 --> C27
C27 -- "No" --> C19
C27 -- "Yes" --> C29 --> C30

C20 -- "Public Rating Form" --> C31 --> C19
C20 -- "Exit" --> C32
end

subgraph MANAGER["Manager Detailed Flow"]
direction TB

M0([Start])
M1["Login as manager
POST /login"]
M2{"Auth + role check passed?"}
M3["Manager dashboard shell"]
M4{"Manager menu click"}

M5["Dashboard:
GET /dashboard/admin/stats"]
